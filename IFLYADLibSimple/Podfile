# 本示例固定使用 6.5.5；请运行 pod install 生成锁文件。安装与运行需在宿主 App 中验证。
source 'https://cdn.cocoapods.org/'

platform :ios, '11.0'

# 展示、落地页与外跳回流应绑定实际来源窗口；宿主窗口和隐私授权要求见 README。

target 'IFLYADLibSimple' do
  use_frameworks!

  # 示例包含全部五种广告，使用 Full；安装后打开生成的 .xcworkspace。
  pod 'IFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/IFLYADLib_iOS/6.5.5/IFLYADLib.podspec'

  # 业务 App 可按需选择广告形式，例如：
  #   pod 'IFLYADLib/Splash', '6.5.5'
  # 导入 <IFLYAdCore/IFLYAdCore.h> 和所用格式模块头。
  # 若裁剪此示例，须同时移除未安装格式的页面编译源和首页入口，详见 README。
end
